@model IEnumerable<InventoryManagement.Models.Product>

@{
    ViewBag.Title = "Inventory Products";
}

<h2>Inventory Products</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div style="color: green; font-weight: bold; margin-bottom: 12px;">
        @TempData["SuccessMessage"]
    </div>
}

<p>
    @Html.ActionLink("Add New Product", "Create", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.ProductId)</th>
            <th>@Html.DisplayNameFor(m => m.ProductName)</th>
            <th>@Html.DisplayNameFor(m => m.Category)</th>
            <th>@Html.DisplayNameFor(m => m.Price)</th>
            <th>@Html.DisplayNameFor(m => m.Quantity)</th>
            <th>@Html.DisplayNameFor(m => m.Description)</th>
            <th>@Html.DisplayNameFor(m => m.CreatedAt)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductId</td>
                <td>@item.ProductName</td>
                <td>@item.Category</td>
                <td>@item.Price.ToString("0.00")</td>
                <td>@item.Quantity</td>
                <td>@item.Description</td>
                <td>@item.CreatedAt.ToString("dd-MM-yyyy HH:mm")</td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.ProductId }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.ProductId })
                </td>
            </tr>
        }
    </tbody>
</table>