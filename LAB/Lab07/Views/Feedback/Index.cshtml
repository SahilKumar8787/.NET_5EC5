@model IEnumerable<FeedbackManagement.Models.Feedback>

@{
    ViewBag.Title = "Feedback Management";
}

<div class="dashboard">

    <div class="hero">
        <h1>Feedback Management</h1>
        <p>View and manage customer feedback from one place.</p>
    </div>

    <div class="stats">

        <div class="stat-card">
            <span>Total Feedback</span>
            <strong>@Model.Count()</strong>
        </div>

        <div class="stat-card">
            <span>Excellent Ratings</span>
            <strong>@Model.Count(x => x.Rating == "Excellent")</strong>
        </div>

        <div class="stat-card">
            <span>Very Good Ratings</span>
            <strong>@Model.Count(x => x.Rating == "Very Good")</strong>
        </div>

    </div>

    <div class="records">

        <div class="records-header">
            <div>
                <h2>📋 Feedback Records</h2>
                <p>Recently submitted customer feedback</p>
            </div>

            <a href="@Url.Action("Create", "Feedback")" class="add-btn">
                + Add Feedback
            </a>
        </div>

        @if (Model.Any())
        {
            <div class="table-wrapper">

                <table>

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Rating</th>
                            <th>Feedback</th>
                            <th>Date</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>

                                <td>
                                    <strong>@item.Name</strong>
                                </td>

                                <td>@item.Email</td>

                                <td>
                                    <span class="rating">
                                        @item.Rating
                                    </span>
                                </td>

                                <td class="comment">
                                    @item.Comment
                                </td>

                                <td>
                                    @item.Date.ToString("dd MMM yyyy")
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty">
                <div class="empty-icon">💬</div>
                <h3>No Feedback Yet</h3>
                <p>Customer feedback will appear here after submission.</p>

                <a href="@Url.Action("Create", "Feedback")" class="add-btn">
                    Give First Feedback
                </a>
            </div>
        }

    </div>

</div>

<style>

    .dashboard {
        max-width: 1100px;
        margin: 0 auto;
        padding: 35px 20px 60px;
    }

    .hero {
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        color: white;
        padding: 32px;
        border-radius: 18px;
        margin-bottom: 25px;
        box-shadow: 0 10px 25px rgba(79, 70, 229, 0.20);
    }

    .hero h1 {
        margin: 0 0 8px;
        font-size: 32px;
    }

    .hero p {
        margin: 0;
        opacity: 0.9;
    }

    .stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 25px;
    }

    .stat-card {
        background: white;
        padding: 22px;
        border-radius: 14px;
        box-shadow: 0 5px 18px rgba(0,0,0,0.08);
        border-left: 5px solid #5946e8;
    }

    .stat-card span {
        display: block;
        color: #667085;
        font-size: 14px;
        margin-bottom: 8px;
    }

    .stat-card strong {
        color: #243b75;
        font-size: 28px;
    }

    .records {
        background: white;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .records-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .records-header h2 {
        color: #243b75;
        margin: 0 0 5px;
    }

    .records-header p {
        color: #777;
        margin: 0;
    }

    .add-btn {
        display: inline-block;
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        color: white;
        padding: 11px 18px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        background: #f0efff;
        color: #243b75;
        text-align: left;
        padding: 14px;
        font-size: 14px;
    }

    td {
        padding: 14px;
        border-bottom: 1px solid #eee;
        color: #444;
        vertical-align: top;
    }

    .rating {
        background: #eee9ff;
        color: #5b42d8;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: bold;
    }

    .comment {
        max-width: 250px;
    }

    .empty {
        text-align: center;
        padding: 50px 20px;
    }

    .empty-icon {
        font-size: 45px;
        margin-bottom: 10px;
    }

    .empty h3 {
        color: #243b75;
        margin-bottom: 5px;
    }

    .empty p {
        color: #777;
        margin-bottom: 20px;
    }

    @@media (max-width: 750px) {

        .stats {
            grid-template-columns: 1fr;
        }

        .records-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        th,
        td {
            white-space: nowrap;
        }
    }

</style>