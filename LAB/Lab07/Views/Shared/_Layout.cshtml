<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title - Feedback Management</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f7fb;
            color: #333;
        }

        .navbar {
            background: #4f46e5;
            padding: 18px 8%;
            color: white;
        }

        .nav-content {
            max-width: 1100px;
            margin: auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .brand {
            font-size: 22px;
            font-weight: bold;
        }

        .nav-link {
            color: white;
            text-decoration: none;
            margin-left: 25px;
        }

            .nav-link:hover {
                text-decoration: underline;
            }

        .main-container {
            max-width: 1100px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .footer {
            text-align: center;
            padding: 25px;
            margin-top: 50px;
            color: #777;
            border-top: 1px solid #ddd;
        }
    </style>
</head>

<body>

    <nav class="navbar">
        <div class="nav-content">
            <div class="brand">Feedback Management</div>

            <div>
                <a href="@Url.Action("Index", "Feedback")"
                   class="nav-link">Feedback</a>
            </div>
        </div>
    </nav>

    <main class="main-container">
        @RenderBody()
    </main>

    <footer class="footer">
        © 2026 Feedback Management System
    </footer>

</body>
</html>