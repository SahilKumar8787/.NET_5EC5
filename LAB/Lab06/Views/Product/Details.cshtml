@model ProductCatalog.Models.Product

@{
    Layout = null;
    ViewBag.Title = "Product Details";
}

<!DOCTYPE html>
<html>
<head>
    <title>Product Details</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f7fb;
            color: #333;
        }

        .header {
            background: linear-gradient(135deg, #315b9b, #4d78b8);
            color: white;
            text-align: center;
            padding: 30px;
        }

            .header h1 {
                margin: 0;
            }

        .container {
            width: 90%;
            max-width: 850px;
            margin: 40px auto;
        }

        .details-card {
            background: white;
            padding: 35px;
            border-radius: 10px;
            box-shadow: 0 3px 14px rgba(0,0,0,0.1);
        }

        .product-icon {
            width: 80px;
            height: 80px;
            background: #e8eef8;
            color: #315b9b;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 38px;
            margin-bottom: 20px;
        }

        .details-card h2 {
            color: #294a7a;
            font-size: 30px;
            margin: 10px 0;
        }

        .category {
            display: inline-block;
            background: #eef3fa;
            color: #315b9b;
            padding: 6px 12px;
            border-radius: 15px;
            font-size: 13px;
        }

        .description {
            color: #666;
            line-height: 1.7;
            font-size: 16px;
            margin: 20px 0;
        }

        .info {
            border-top: 1px solid #ddd;
            padding-top: 20px;
        }

            .info p {
                margin: 12px 0;
            }

        .price {
            color: #198754;
            font-size: 26px;
            font-weight: bold;
        }

        .back-btn {
            display: inline-block;
            margin-top: 20px;
            background: #315b9b;
            color: white;
            text-decoration: none;
            padding: 10px 18px;
            border-radius: 5px;
        }

            .back-btn:hover {
                background: #244778;
            }
    </style>
</head>

<body>

    <div class="header">
        <h1>Product Details</h1>
        <p>Product Information</p>
    </div>

    <div class="container">

        <div class="details-card">

            <div class="product-icon">
                🛍️
            </div>

            <span class="category">
                @Model.Category
            </span>

            <h2>
                @Model.ProductName
            </h2>

            <p class="description">
                @Model.Description
            </p>

            <div class="info">

                <p>
                    <strong>Product ID:</strong>
                    @Model.ProductId
                </p>

                <p>
                    <strong>Category:</strong>
                    @Model.Category
                </p>

                <p>
                    <strong>Availability:</strong>
                    @Model.Stock
                </p>

                <p>
                    <strong>Rating:</strong>
                    ⭐ @Model.Rating / 5
                </p>

                <p class="price">
                    ₹ @Model.Price
                </p>

            </div>

            <a href="@Url.Action("Index", "Product")"
               class="back-btn">
                ← Back to Products
            </a>

        </div>

    </div>

</body>
</html>