@model IEnumerable<ProductCatalog.Models.Product>

@{
    Layout = null;
    ViewBag.Title = "Product Catalog";
}

<!DOCTYPE html>

<html>
<head>

    <title>Product Catalog</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f7fb;
            color: #333;
        }

        .header {
            background: linear-gradient(135deg, #315b9b, #4d78b8);
            color: white;
            padding: 35px 20px;
            text-align: center;
        }

        .header h1 {
            margin: 0;
            font-size: 34px;
        }

        .header p {
            margin-top: 10px;
            font-size: 16px;
        }

        .container {
            width: 90%;
            max-width: 1100px;
            margin: 35px auto;
        }

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .top-bar h2 {
            margin: 0;
            color: #294a7a;
        }

        .count {
            background: #e8eef8;
            color: #294a7a;
            padding: 8px 15px;
            border-radius: 20px;
            font-size: 14px;
        }

        .products {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 22px;
        }

        .product {
            background: white;
            border-radius: 10px;
            padding: 22px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.09);
            transition: 0.2s;
        }

        .product:hover {
            transform: translateY(-3px);
        }

        .icon {
            width: 55px;
            height: 55px;
            border-radius: 50%;
            background: #e8eef8;
            color: #315b9b;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 25px;
            margin-bottom: 15px;
        }

        .product h2 {
            color: #294a7a;
            margin: 5px 0 10px;
            font-size: 21px;
        }

        .category {
            display: inline-block;
            background: #eef3fa;
            color: #315b9b;
            padding: 5px 10px;
            border-radius: 15px;
            font-size: 12px;
            margin-bottom: 12px;
        }

        .description {
            color: #666;
            line-height: 1.5;
            min-height: 65px;
        }

        .price {
            color: #198754;
            font-size: 21px;
            font-weight: bold;
            margin: 15px 0 5px;
        }

        .stock {
            color: #198754;
            font-size: 13px;
            margin-bottom: 15px;
        }

        .details-btn {
            display: inline-block;
            text-decoration: none;
            background: #315b9b;
            color: white;
            padding: 9px 16px;
            border-radius: 5px;
            font-size: 14px;
        }

        .details-btn:hover {
            background: #244778;
        }

        .footer {
            text-align: center;
            padding: 25px;
            color: #777;
            font-size: 13px;
        }

        @@media(max-width: 900px) {
            .products {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media(max-width: 600px) {
            .products {
                grid-template-columns: 1fr;
            }

            .top-bar {
                display: block;
            }
        }

    </style>

</head>

<body>

    <div class="header">

        <h1>Product Catalog</h1>

        <p>Explore our available products</p>

    </div>


    <div class="container">

        <div class="top-bar">

            <h2>Available Products</h2>

            <span class="count">
                @Model.Count() Products
            </span>

        </div>


        <div class="products">

            @foreach (var product in Model)
            {
                <div class="product">

                    <div class="icon">
                        🛍️
                    </div>

                    <span class="category">
                        @product.Category
                    </span>

                    <h2>
                        @product.ProductName
                    </h2>

                    <p class="description">
                        @product.Description
                    </p>

                    <div class="price">
                        ₹ @product.Price
                    </div>

                    <div class="stock">
                        ● @product.Stock
                    </div>

                    <a href="@Url.Action("Details", "Product", new { id = product.ProductId })"
                       class="details-btn">
                        View Details
                    </a>

                </div>
            }

        </div>

    </div>


    <div class="footer">
        Product Catalog Application | ASP.NET MVC
    </div>

</body>

</html>